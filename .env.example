# Supabase (Project Settings, API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://txaqthvlpjzzyyrszbdd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The JWT_SECRET of the Supabase install (/docker/sb-capybaroar/.env). Lets the server check sessions itself instead of
# asking Supabase Auth on every page (src/lib/jwt.ts). Server only; never NEXT_PUBLIC_. Empty: the slower network check.
SUPABASE_JWT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_KEY=
APP_URL=http://localhost:3000
# Partner API white-label connect: hosts a partner's return_url may be on after a network sign-in, exact names, comma
# separated (Morning Telos: chat.morningtelos.com). Empty: no white-label connect can start.
PARTNER_RETURN_HOSTS=
# Cloudflare Turnstile bot check on sign-in, sign-up and reset (Cloudflare, Turnstile, add a site). Read on the server
# when a page loads, no rebuild needed. Then turn on bot protection in Supabase (Authentication, Attack Protection) with
# the secret key. Leave empty to turn it off.
TURNSTILE_SITE_KEY=
# "Continue with Google" shows when Google is on in Supabase Auth. 0 hides it, 1 shows it anyway.
GOOGLE_SIGNIN=
# Agent
ANTHROPIC_API_KEY=
# AI pictures and videos (fal.ai, Dashboard, API keys). Leave empty to turn them off.
FAL_KEY=
# Channels
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_PAGE_CLIENT_ID=
LINKEDIN_PAGE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# More channels
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
GOOGLE_GMB_CLIENT_ID=
GOOGLE_GMB_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# Failure alerts by email (Hostinger: smtp.hostinger.com, 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Who the app's emails come from: an address on mail.capybaroar.com (the Resend team that owns SMTP_PASS's key).
ALERT_FROM="Capybaroar <hello@mail.capybaroar.com>"
# Billing (Stripe). Leave STRIPE_SECRET_KEY empty to turn billing off.
# The webhook needs: checkout.session.completed, customer.subscription.created/updated/deleted, payment_intent.succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring prices: Creator $29/$290, Pro $49/$490, Agency $149/$1,490 (month/year). Credit packs need no price ids.
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_YEARLY=
# Old prices people still pay that keep their plan, as price_id:plan pairs: price_abc:pro,price_def:agency
STRIPE_LEGACY_PRICES=
