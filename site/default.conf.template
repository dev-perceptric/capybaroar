# capybaroar.com: the homepage's own files first; any other one-word address is a link-in-bio page, served by the app
# (capybaroar-web) over the private network, so visitors' addresses reach it as they are. The bio page's files
# (/_next/), pictures and posts (/b/) and tracked links (/l/) go the same way.

# The help docs moved to https://docs.capybaroar.com (the capybaroar-docs repo). Every old /docs address, with or
# without .html, .md or a trailing slash, goes to the matching new page; anything else under /docs goes to its home.
map $uri $old_docs_page {
  "~^/docs/(?<slug>[a-z0-9-]+)(\.html|\.md)?/?$" $slug;
  default "";
}
map $old_docs_page $new_docs_path {
  default                    /;
  welcome                    /get-started/welcome/;
  create-account             /get-started/create-account/;
  connect-a-channel          /get-started/connect-a-channel/;
  schedule-your-first-post   /get-started/schedule-your-first-post/;
  instagram                  /channels/instagram/;
  facebook                   /channels/facebook/;
  tiktok                     /channels/tiktok/;
  linkedin                   /channels/linkedin/;
  youtube                    /channels/youtube/;
  x                          /channels/x/;
  threads                    /channels/threads/;
  pinterest                  /channels/pinterest/;
  bluesky                    /channels/bluesky/;
  mastodon                   /channels/mastodon/;
  discord                    /channels/discord/;
  agent                      /ai/agent/;
  plan-a-week                /ai/plan-a-week/;
  ai-credits                 /ai/ai-credits/;
  rewrite-with-ai            /ai/rewrite-with-ai/;
  mcp                        /ai/mcp/;
}

server {
  listen 8080;
  listen [::]:8080;
  root /usr/share/nginx/html;
  absolute_redirect off;
  gzip on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain;

  # Where the app is: Fly's private DNS by default, the Docker network on the VPS (set in the Dockerfile and the
  # compose file; nginx fills these in at start). A variable in proxy_pass makes nginx look the app up when asked.
  resolver ${CAPY_RESOLVER};
  set $app ${CAPY_APP};

  proxy_http_version 1.1;
  proxy_set_header Host app.capybaroar.com;
  proxy_set_header Fly-Client-IP ${CAPY_CLIENT_IP};
  proxy_set_header X-Forwarded-For ${CAPY_CLIENT_IP};
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host $host;
  # Tells the app this visit came through capybaroar.com, so it doesn't send it back here.
  proxy_set_header X-Capy-Bio 1;
  proxy_read_timeout 30s;

  # The homepage preview became the homepage.
  location = /home-v2 { return 301 /; }

  # /docs, /docs.html, /docs.md, /docs/ and every /docs/... address.
  location ~ ^/docs(?:[./]|$) {
    return 301 https://docs.capybaroar.com$new_docs_path;
  }

  location / {
    try_files $uri $uri.html $uri/ @bio;
  }

  location ~ ^/(b|l|_next)/ {
    proxy_pass $app;
  }

  location @bio {
    rewrite "^/([a-z0-9][a-z0-9-]{1,38}[a-z0-9])/?$" /b/$1 break;
    return 404;
    proxy_pass $app;
    proxy_intercept_errors on;
  }

  error_page 404 /404.html;
}
