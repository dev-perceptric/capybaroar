            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{role=\"app\", type=\"audit\"} | json | action=~\"api_key.created|app.connected\" or (action=\"member.role_changed\" and role=~\"owner|admin\")",
          "queryType": "range"
