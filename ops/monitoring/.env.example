# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
# Never commit .env (it is in .gitignore).

# The name Caddy serves and gets a certificate for. Point its DNS A record at this server first.
LOGS_DOMAIN=logs.capybaroar.com
# For Let's Encrypt's expiry notices.
ACME_EMAIL=[your email]

# Who may push logs: the app VPS. Space separated, CIDR form.
APP_VPS_IPS=45.90.109.7/32
# Who may open Grafana: your own addresses, space separated. With no fixed address, use an SSH tunnel and leave
# 127.0.0.1/32 here (README.md, "Open Grafana").
GRAFANA_ALLOW_IPS=127.0.0.1/32

GRAFANA_ADMIN_USER=capy-admin
# A long random password (openssl rand -base64 24), saved in your password manager. Used on the first start only.
GRAFANA_ADMIN_PASSWORD=

# The same SMTP account as the app's SMTP_* settings. Port 465 is TLS from the start.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=[sending address]
SMTP_PASSWORD=
SMTP_FROM=[sending address]
# Who gets alerts. Several: separate with ";".
ALERT_EMAIL=[your email]

# Alert thresholds (grafana/provisioning/alerting/rules.yml). Leave a line out to keep its default.
# App errors in 10 minutes
ALERT_ERRORS_10M=20
# Failed sign-ins in 10 minutes, all workspaces together
ALERT_FAILED_SIGNINS_10M=30
# Failed SSH sign-ins on the app VPS in 10 minutes
ALERT_SSH_FAILED_10M=60
# 5xx answers from Caddy in 10 minutes
ALERT_HTTP_5XX_10M=25
# App runner starts in 15 minutes (restart loop)
ALERT_APP_STARTS_15M=3
