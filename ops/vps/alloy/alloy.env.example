# Copy to /etc/capybaroar/alloy.env on the app VPS, fill in, then: chmod 600 /etc/capybaroar/alloy.env

# The compliance server's push address (ops/monitoring, LOGS_DOMAIN) and the user and password from its step 4.
LOKI_PUSH_URL=https://logs.capybaroar.com/loki/api/v1/push
LOKI_PUSH_USER=capy-vps
LOKI_PUSH_PASSWORD=

# The host label on every line.
LOG_HOST=app-vps

# Container names to ship, as regexes matched against the whole name (docker ps --format '{{.Names}}').
# Leave a line out to keep the default in config.alloy.
CAPY_APP_CONTAINERS=capybaroar-web.*|capybaroar-app.*|capybaroar
CAPY_SITE_CONTAINERS=capybaroar-site.*|capybaroar-homepage.*
SUPABASE_PROJECT=sb-capybaroar
SUPABASE_SERVICES=auth|kong|storage|db
